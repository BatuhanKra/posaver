---
import { tx, type Lang } from '../../lib/i18n';
import SectionShell from '../SectionShell.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);

const values = [
  t('Döngüsel', 'Circular'),
  t('Yerel, izlenebilir ve veri odaklı', 'Local, traceable and data-driven'),
  t('Koku odaklı ileri dönüşüm', 'Scent-focused upcycling'),
  t('Ölçülebilir iklim faydası', 'Measurable climate benefit'),
];
---

<SectionShell id="neden-posaver" tone="dark-forest" kicker={t('Özet', 'In short')} title={t('Neden POSAVER?', 'Why POSAVER?')}>
  <ul class="values">
    {
      values.map((v, i) => (
        <li class="value" data-reveal>
          <span class="value__n">{String(i + 1).padStart(2, '0')}</span>
          <span class="value__t">{v}</span>
        </li>
      ))
    }
  </ul>

  <p class="statement closing" data-reveal>
    {
      t(
        'POSAVER, dağınık ve hızla bozulan kahve posasını kaynağa yakın ve izlenebilir biçimde toplayıp aromatik değerini geri kazanan; iklim etkisini veriyle ölçerek yüksek katma değerli B2B koku girdisine dönüştürmeyi hedefleyen bütünleşik bir modeldir.',
        'POSAVER is an integrated model that collects scattered, fast-spoiling coffee grounds close to the source and in a traceable way, recovers their aromatic value, and aims to turn them into a high-value B2B fragrance ingredient while measuring climate impact with data.',
      )
    }
  </p>
</SectionShell>

<style>
  .values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 60rem;
  }
  .value {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  .value:last-child {
    border-bottom: 1px solid var(--line);
  }
  .value__n {
    font-size: var(--text-small);
    color: var(--accent);
    min-width: 1.8rem;
  }
  .value__t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.6vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .closing {
    max-width: 46ch;
    font-size: clamp(1.15rem, 1.8vw, 1.6rem);
    line-height: 1.5;
    color: var(--muted);
    font-family: var(--font-body);
    font-weight: 400;
    font-variation-settings: normal;
    letter-spacing: 0;
  }
</style>
