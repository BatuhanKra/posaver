---
import { tx, type Lang } from '../../lib/i18n';
import SectionShell from '../SectionShell.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);
---

<SectionShell id="deger-zinciri" tone="light-gray" kicker={t('Değer zinciri', 'Value chain')} title={t('Kim için değer yaratıyoruz?', 'Who do we create value for?')}>
  <div class="chain">
    <article class="chain__node card" data-reveal>
      <p class="chain__tag">{t('Kaynak / tedarik ortakları', 'Source / supply partners')}</p>
      <h3>{t('Kafeler', 'Cafés')}</h3>
      <ul>
        <li>{t('Düzenli posa', 'Regular grounds')}</li>
        <li>{t('Ayrı toplama', 'Separate collection')}</li>
        <li>{t('Parti takibi', 'Batch tracking')}</li>
      </ul>
    </article>

    <div class="chain__link" aria-hidden="true"><span data-draw></span></div>

    <article class="chain__node chain__node--core" data-reveal>
      <p class="chain__tag">{t('POSAVER dönüşüm noktası', 'POSAVER conversion point')}</p>
      <h3>{t('Posadan koku girdisine', 'From grounds to fragrance ingredient')}</h3>
      <ol>
        <li>{t('Yerel toplama', 'Local collection')}</li>
        <li>{t('Kurutma', 'Drying')}</li>
        <li>{t('Ekstraksiyon', 'Extraction')}</li>
        <li>{t('Filtrasyon', 'Filtration')}</li>
        <li>{t('İzlenebilirlik (QR / parti verisi)', 'Traceability (QR / batch data)')}</li>
      </ol>
    </article>

    <div class="chain__link" aria-hidden="true"><span data-draw></span></div>

    <article class="chain__node card" data-reveal>
      <p class="chain__tag">{t('B2B müşteri', 'B2B customer')}</p>
      <h3>{t('Parfüm, esans ve kozmetik üreticileri', 'Perfume, essence and cosmetics makers')}</h3>
      <p class="chain__note">
        {t('Kaynağı belirli, izlenebilir ve proses verisiyle desteklenen koku girdisi.', 'A fragrance ingredient with a known source, traceable and backed by process data.')}
      </p>
      <p class="chain__note">
        {t('AB’nin CSRD gibi sürdürülebilirlik raporlama kuralları, büyük markalardan tedarik zinciri emisyonlarını da istiyor. Ölçülmüş ve izlenebilir girdi bu yüzden değer taşıyor.', 'EU sustainability reporting rules such as the CSRD ask big brands to report supply-chain emissions too. That is why a measured, traceable ingredient is valuable.')}
      </p>
    </article>
  </div>

  <p class="source-note">{t('POSAVER Araştırma, karbon ticareti ve AB mevzuatı (Ekim 2026)', 'POSAVER research on carbon trading and EU regulation (October 2026)')}</p>
</SectionShell>

<style>
  .chain {
    display: grid;
    grid-template-columns: 1fr auto 1.3fr auto 1fr;
    align-items: stretch;
    gap: 0;
  }
  .chain__node {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .chain__node ul,
  .chain__node ol {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
    color: var(--muted);
  }
  .chain__node--core {
    background: var(--forest);
    color: var(--crema);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 2.6vw, 2.5rem);
    --muted: rgb(233 220 201 / 0.78);
    --accent: var(--moss);
  }
  .chain__tag {
    font-size: var(--text-small);
    color: var(--accent);
    font-weight: 500;
  }
  .chain__note {
    color: var(--muted);
  }
  .chain__link {
    align-self: center;
    width: clamp(2rem, 5vw, 5rem);
    height: 2px;
    background: var(--line);
    position: relative;
  }
  .chain__link span {
    display: block;
    height: 100%;
    background: var(--roast);
    transform-origin: left;
    transform: scaleX(var(--d, 1));
  }
  .chain__link::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.6rem;
    height: 0.6rem;
    border-top: 2px solid var(--roast);
    border-right: 2px solid var(--roast);
    transform: translateY(-50%) rotate(45deg);
  }

  @media (max-width: 899px) {
    .chain {
      grid-template-columns: 1fr;
    }
    .chain__link {
      width: 2px;
      height: 3rem;
      justify-self: center;
    }
    .chain__link span {
      width: 100%;
      transform-origin: top;
      transform: scaleY(var(--d, 1));
    }
    .chain__link::after {
      right: 50%;
      top: auto;
      bottom: 0;
      transform: translateX(50%) rotate(135deg);
    }
  }
</style>
