---
import SectionShell from '../SectionShell.astro';
---

<SectionShell id="deger-zinciri" tone="light-gray" kicker="Değer zinciri" title="Kim için değer yaratıyoruz?">
  <div class="chain">
    <article class="chain__node card" data-reveal>
      <p class="chain__tag">Kaynak / tedarik ortakları</p>
      <h3>Kafeler</h3>
      <ul>
        <li>Düzenli posa</li>
        <li>Ayrı toplama</li>
        <li>Parti takibi</li>
      </ul>
    </article>

    <div class="chain__link" aria-hidden="true"><span data-draw></span></div>

    <article class="chain__node chain__node--core" data-reveal>
      <p class="chain__tag">POSAVER dönüşüm noktası</p>
      <h3>Posadan koku girdisine</h3>
      <ol>
        <li>Yerel toplama</li>
        <li>Kurutma</li>
        <li>Ekstraksiyon</li>
        <li>Filtrasyon</li>
        <li>İzlenebilirlik (QR / parti verisi)</li>
      </ol>
    </article>

    <div class="chain__link" aria-hidden="true"><span data-draw></span></div>

    <article class="chain__node card" data-reveal>
      <p class="chain__tag">B2B müşteri</p>
      <h3>Parfüm, esans ve kozmetik üreticileri</h3>
      <p class="chain__note">
        Kaynağı belirli, izlenebilir ve proses verisiyle desteklenen koku girdisi.
      </p>
    </article>
  </div>
</SectionShell>

<style>
  .chain {
    display: grid;
    grid-template-columns: 1fr auto 1.3fr auto 1fr;
    align-items: stretch;
    gap: 0;
  }
  .chain__node {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .chain__node ul,
  .chain__node ol {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
    color: var(--muted);
  }
  .chain__node--core {
    background: var(--forest);
    color: var(--crema);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 2.6vw, 2.5rem);
    --muted: rgb(233 220 201 / 0.78);
    --accent: var(--moss);
  }
  .chain__tag {
    font-size: var(--text-small);
    color: var(--accent);
    font-weight: 500;
  }
  .chain__note {
    color: var(--muted);
  }
  .chain__link {
    align-self: center;
    width: clamp(2rem, 5vw, 5rem);
    height: 2px;
    background: var(--line);
    position: relative;
  }
  .chain__link span {
    display: block;
    height: 100%;
    background: var(--roast);
    transform-origin: left;
    transform: scaleX(var(--d, 1));
  }
  .chain__link::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.6rem;
    height: 0.6rem;
    border-top: 2px solid var(--roast);
    border-right: 2px solid var(--roast);
    transform: translateY(-50%) rotate(45deg);
  }

  @media (max-width: 899px) {
    .chain {
      grid-template-columns: 1fr;
    }
    .chain__link {
      width: 2px;
      height: 3rem;
      justify-self: center;
    }
    .chain__link span {
      width: 100%;
      transform-origin: top;
      transform: scaleY(var(--d, 1));
    }
    .chain__link::after {
      right: 50%;
      top: auto;
      bottom: 0;
      transform: translateX(50%) rotate(135deg);
    }
  }
</style>
