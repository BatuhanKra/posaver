---
import { tx, type Lang } from '../../lib/i18n';
import SectionShell from '../SectionShell.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);

const pairs = [
  { k: t('Etanol yanıcı solvent', 'Ethanol is a flammable solvent'), c: t('Havalandırmalı çeker ocak, düşük hacim (<5 L), KKD, kıvılcımsız laboratuvar', 'Ventilated fume hood, low volume (<5 L), PPE, spark-free laboratory') },
  { k: t('Kurutma elektrik tüketir', 'Drying uses electricity'), c: t('kWh/kg ölçümü, pasif/güneş destekli kurutma değerlendirmesi', 'Measure kWh/kg, assess passive / solar-assisted drying') },
  { k: t('Mesafe arttıkça taşıma ayak izi artar', 'Transport footprint grows with distance'), c: t('Mikro-toplama ağı', 'A micro-collection network') },
  { k: t('Proseste fire riski', 'Loss risk in the process'), c: t('Kütle dengesiyle fire ve yan akış takibi, bertarafın minimize edilmesi', 'Track losses and side streams with a mass balance, minimise disposal') },
];

const needs = [
  { t: t('Ekipman', 'Equipment'), d: t('Etanol + cam ekstraksiyon/filtrasyon düzeneği', 'Ethanol + glass extraction / filtration setup') },
  { t: t('Hammadde', 'Raw material'), d: t('Pilot bölgede 3 kafeden ıslak posa', 'Wet grounds from 3 cafés in the pilot area') },
  { t: t('Alan', 'Space'), d: t('Havalandırmalı kontrollü alan', 'A ventilated, controlled area') },
  { t: t('Ekip', 'Team'), d: t('Proses sorumlusu + saha/toplama sorumlusu', 'A process lead + a field / collection lead') },
  { t: t('Paydaşlar', 'Stakeholders'), d: t('3 pilot kafe + laboratuvar + koku değerlendirme paydaşı', '3 pilot cafés + a laboratory + a scent evaluation partner') },
  { t: t('Bütçe', 'Budget'), d: t('Solvent, cam ekipman, kurutma, toplama kapları, lojistik', 'Solvent, glassware, drying, collection bins, logistics') },
];
---

<SectionShell id="pilot" tone="light" kicker="Pilot" title={t('Teknik kararlar ve kısıtlar', 'Technical decisions and constraints')}>
  <div class="pairs">
    <div class="pairs__head" aria-hidden="true">
      <span>{t('Kısıt', 'Constraint')}</span>
      <span></span>
      <span>{t('Çözüm', 'Response')}</span>
    </div>
    {
      pairs.map((p) => (
        <div class="pair" data-reveal>
          <p class="pair__k">{p.k}</p>
          <span class="pair__arrow" aria-hidden="true">→</span>
          <p class="pair__c">{p.c}</p>
        </div>
      ))
    }
  </div>

  <div class="needs">
    <h3 data-reveal>{t('Kaynak ihtiyaçları', 'Resource needs')}</h3>
    <ul class="needs__grid">
      {
        needs.map((n) => (
          <li class="needs__item card" data-reveal>
            <p class="needs__t">{n.t}</p>
            <p>{n.d}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="source-note">
    Page et al. (2017) Waste Management, DOI:10.1016/j.wasman.2017.08.043; Andrade et al. (2022) Foods
  </p>
</SectionShell>

<style>
  .pairs {
    display: grid;
    max-width: 66rem;
  }
  .pairs__head,
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1.4fr);
    gap: 1rem;
    align-items: baseline;
  }
  .pairs__head {
    font-size: var(--text-small);
    color: var(--muted);
    padding-bottom: 0.75rem;
  }
  .pair {
    border-top: 1px solid var(--line);
    padding: 1.25rem 0;
  }
  .pair__k {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 1.9vw, 1.6rem);
    line-height: 1.25;
  }
  .pair__arrow {
    color: var(--accent);
    font-size: 1.4rem;
  }
  .pair__c {
    color: var(--muted);
  }

  .needs {
    display: grid;
    gap: 1.25rem;
  }
  .needs h3 {
    font-size: 1.4rem;
  }
  .needs__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .needs__item {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .needs__t {
    font-size: var(--text-small);
    color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 899px) {
    .needs__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .pairs__head {
      display: none;
    }
    .pair {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .pair__arrow {
      transform: rotate(90deg);
      width: 1.4rem;
    }
    .needs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
