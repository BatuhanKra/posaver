---
import { url } from '../../lib/url';
import SectionShell from '../SectionShell.astro';
import { getPosts, formatDate } from '../../lib/blog';

const posts = (await getPosts()).slice(0, 3);
---

<SectionShell id="blog" tone="light" kicker="Blog" title="Son yazılar">
  <ul class="posts">
    {
      posts.map((p) => (
        <li class="post" data-reveal>
          <a href={url(`/blog/${p.id}`)}>
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
  <a class="btn btn--dark" href={url('/blog')} data-reveal data-cup-avoid>Tüm yazılar</a>
</SectionShell>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    max-width: 66rem;
  }
  .post {
    border-top: 1px solid var(--line);
  }
  .post:last-child {
    border-bottom: 1px solid var(--line);
  }
  .post a {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding: 1.6rem 0;
    text-decoration: none;
    transition: transform 0.5s var(--ease-out);
  }
  .post a:hover {
    transform: translateX(0.5rem);
  }
  .post time {
    font-size: var(--text-small);
    color: var(--accent);
    font-weight: 500;
    grid-row: 1 / span 2;
    padding-top: 0.5rem;
  }
  .post h3 {
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
  }
  .post p {
    color: var(--muted);
  }
  .btn--dark {
    align-self: flex-start;
    color: var(--espresso);
  }
  .btn--dark:hover {
    background: var(--espresso);
    color: var(--crema);
  }

  @media (max-width: 639px) {
    .post a {
      grid-template-columns: 1fr;
    }
    .post time {
      grid-row: auto;
      padding-top: 0;
    }
  }
</style>
