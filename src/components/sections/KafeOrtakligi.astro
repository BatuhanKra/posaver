---
import { tx, type Lang } from '../../lib/i18n';
import SectionShell from '../SectionShell.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);

const give = [
  t('Ücretsiz, düzenli toplama ve kapaklı kova', 'Free, regular collection and a lidded bin'),
  t('Yıllık kaçınılan CO₂ raporu (kredi değil, raporlama)', 'Annual avoided-CO₂ report (reporting, not credits)'),
  t('“Sıfır Atık Kafe” etiketi (belediyeyle görüşülüyor)', '“Zero Waste Café” label (in talks with the municipality)'),
  t('Kendi posasından üretilmiş ürün: konsinye, raf fiyatının %30’u kafeye', 'A product made from its own grounds: on consignment, 30% of the shelf price goes to the café'),
  t('Sosyal medyada ve web sitesinde kafe tanıtımı', 'Promotion of the café on social media and our website'),
];

const take = [
  t('Yalnızca espresso posası, kahve dışı atık karışmadan', 'Espresso grounds only, with no non-coffee waste mixed in'),
  t('Günlük ağırlık kaydına izin (QR)', 'Permission to log daily weight (QR)'),
  t('En az 3 aylık katılım', 'At least 3 months of participation'),
  t('Ürünü rafta sergileme ve satış', 'Displaying and selling the product on the shelf'),
];

const routes = [
  { n: t('20 kafeye kadar', 'Up to 20 cafés'), t: t('Kargo bisikleti', 'Cargo bike'), d: t('Tek ilçe kümesinde, 5–10 km bisiklet menzilinde. Toplama maliyeti ve emisyonu sıfır.', 'Within a single district cluster, 5–10 km of cycling range. Collection cost and emissions are zero.') },
  { n: t('50 kafe', '50 cafés'), t: t('Sabit güzergâh', 'Fixed route'), d: t('Bisiklet ve küçük araç; her gün aynı saatte aynı sırayla. Kafe personelinin rutini değişmez.', 'Bike and small vehicle; the same order at the same time every day. The café staff’s routine does not change.') },
  { n: t('100–200 kafe', '100–200 cafés'), t: t('Mikro merkezler', 'Micro hubs'), d: t('Her ilçeye bir ön işlem noktası. Posa merkeze taşınmadan önce orada kurutulur, ağırlık ve kilometre yarıya iner.', 'A pre-processing point in every district. Grounds are dried there before moving to the main site, so weight and kilometres are halved.') },
];
---

<SectionShell id="kafe-ortakligi" tone="dark-espresso" kicker={t('Kafe ortaklığı', 'Café partnership')} title={t('Kafe için adil oran', 'A fair deal for the café')}>
  <p class="section__lead" data-reveal>
    {t('Posasını veren kafe karşılığında rapor, görünürlük ve ek gelir kazanır. Kafenin tek işi, posayı ayrı kaba almak.', 'A café that gives us its grounds gets a report, visibility and extra income in return. The café’s only job is to put the grounds in a separate container.')}
  </p>

  <div class="deal">
    <article class="deal__col card" data-reveal>
      <h3>{t('Kafeye verdiğimiz', 'What we give the café')}</h3>
      <ul>
        {give.map((g) => <li>{g}</li>)}
      </ul>
    </article>
    <article class="deal__col card" data-reveal>
      <h3>{t('Kafeden aldığımız', 'What we ask of the café')}</h3>
      <ul>
        {take.map((g) => <li>{g}</li>)}
      </ul>
      <p class="deal__note">{t('Münhasırlık yok. Satılmayan ürün geri alınır, kafe stok riski almaz.', 'No exclusivity. Unsold product is taken back, so the café carries no stock risk.')}</p>
    </article>
  </div>

  <div class="route">
    <h3 data-reveal>{t('Toplama nasıl ölçeklenir?', 'How does collection scale?')}</h3>
    <ol class="route__list">
      {
        routes.map((r) => (
          <li class="route__item" data-reveal>
            <span class="route__n">{r.n}</span>
            <h4>{r.t}</h4>
            <p>{r.d}</p>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="statement" data-reveal>
    {
      lang === 'en' ? (
        <>The rule: grounds are <em>never moved on a single-purpose vehicle trip</em>.</>
      ) : (
        <>Kural: posa <em>hiçbir zaman tek amaçlı araç seferiyle</em> taşınmaz.</>
      )
    }
  </p>
  <p class="rule" data-reveal>
    {
      lang === 'en' ? (
        <>In our model the emissions saved by diverting grounds from the bin are about 0.63 kg CO<sub>2</sub>e per kg of wet grounds. Collecting by vehicle eats roughly a quarter of that; collecting by bike eats none.</>
      ) : (
        <>Modelimizde çöpten kurtarılan emisyon yaklaşık 0,63 kg CO<sub>2</sub>e / kg ıslak posa. Araçlı toplama bunun yaklaşık dörtte birini yiyor, bisikletle toplama ise hiçbirini.</>
      )
    }
  </p>

  <p class="source-note">{t('POSAVER lojistik ve kafe ortaklığı çalışması, maliyet modeli varsayımları (Ekim 2026)', 'POSAVER logistics and café partnership study, cost model assumptions (October 2026)')}</p>
</SectionShell>

<style>
  .deal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 1.6vw, 1.25rem);
  }
  .deal__col {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .deal__col ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.5rem;
    color: var(--muted);
  }
  .deal__note {
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .route {
    display: grid;
    gap: 1.25rem;
  }
  .route__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .route__item {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .route__n {
    font-size: var(--text-small);
    color: var(--accent);
    font-weight: 600;
  }
  .route h4 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .route p {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .rule {
    text-align: center;
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: 60ch;
  }

  @media (max-width: 899px) {
    .deal,
    .route__list {
      grid-template-columns: 1fr;
    }
  }
</style>
