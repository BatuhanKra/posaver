---
import { tx, type Lang } from '../../lib/i18n';
import SectionShell from '../SectionShell.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);
---

<SectionShell id="neden-onemli" tone="dark-forest" kicker={t('Neden önemli?', 'Why it matters')} title={t('Bir kupa kahvenin görünmeyen iklim bedeli', 'The hidden climate price of a cup of coffee')}>
  <ul class="stats">
    <li class="stat" data-reveal>
      <p class="stat__v"><span data-count="80">80</span><span class="stat__u">{t('kat', 'times')}</span></p>
      <p class="stat__d">
        {
          lang === 'en' ? (
            <>Warming effect of methane from rotting grounds compared with CO<sub>2</sub> over the first 20 years (approximate).</>
          ) : (
            <>Oksijensiz çürüyen posadan çıkan metanın, CO<sub>2</sub>'ye kıyasla ilk 20 yıldaki ısınma etkisi (yaklaşık).</>
          )
        }
      </p>
    </li>
    <li class="stat" data-reveal>
      <p class="stat__v"><span data-count="18">18</span><span class="stat__u">{t('milyon ton', 'million tonnes')}</span></p>
      <p class="stat__d">{t('Dünyada yılda yaklaşık oluşan ıslak kahve posası.', 'Wet coffee grounds produced worldwide each year, roughly.')}</p>
    </li>
    <li class="stat" data-reveal>
      <p class="stat__v stat__v--text">{t('AB Atık Çerçeve Direktifi', 'EU Waste Framework Directive')}</p>
      <p class="stat__d">{t('Biyo-atığın kaynağında ayrıştırılmasını veya ayrı toplanmasını öngörüyor.', 'Requires bio-waste to be separated or collected separately at the source.')}</p>
    </li>
    <li class="stat" data-reveal>
      <p class="stat__v"><span class="stat__nw"><span data-count="24">24</span>–<span data-count="48">48</span></span><span class="stat__u">{t('saat', 'hours')}</span></p>
      <p class="stat__d">{t('Posa bu sürede küflendiği için yerel çözüm gerekiyor.', 'Grounds go mouldy in this time, so the solution has to be local.')}</p>
    </li>
  </ul>

  <blockquote class="statement quote" data-reveal>
    {t('“Küçük ve dağınık görünen bir atık akışı, metan gazının yüksek kısa dönemli ısınma etkisi nedeniyle yerelde hızlı müdahale gerektiriyor.”', '“A waste stream that looks small and scattered calls for a fast local response, because methane has such a strong short-term warming effect.”')}
  </blockquote>

  <p class="source-note">IFST (2021); IPCC AR6 (2021); EU Waste Framework Directive</p>
</SectionShell>

<style>
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 3rem);
  }
  .stat {
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
  }
  .stat__v {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.8rem, 5.2vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    background: linear-gradient(180deg, #ffffff 20%, #b9c9a3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .stat__u {
    display: block;
    font-size: 0.4em;
    letter-spacing: -0.02em;
    margin-top: 0.25em;
  }
  .stat__nw {
    white-space: nowrap;
  }
  .stat__v--text {
    font-size: clamp(1.6rem, 2.4vw, 2.3rem);
    line-height: 1.12;
  }
  .stat__d {
    color: var(--muted);
    font-size: 1rem;
    max-width: 30ch;
  }
  .quote {
    margin-block: 0;
    max-width: 30ch;
  }

  @media (max-width: 1023px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
