---
import { tx, type Lang } from '../../lib/i18n';
import SectionShell from '../SectionShell.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);

const items = [
  {
    s: t('Tamamlandı', 'Done'),
    k: 'done',
    t: t('Kayseri birincisi', 'Kayseri winner'),
    d: t('AB Türkiye Delegasyonu desteğiyle düzenlenen EU Climate Ideathon 2026 Kayseri yerel finalinde birinci olduk.', 'We won first place at the Kayseri local final of EU Climate Ideathon 2026, organised with the support of the EU Delegation to Türkiye.'),
  },
  {
    s: t('Sürüyor', 'Ongoing'),
    k: 'live',
    t: t('Sahada pilot', 'Field pilot'),
    d: t('Bir üniversite kampüsündeki 3 kafede ayrı posa toplama pilotu: toplama, kayıt ve rota adımları gerçek kafe akışında test ediliyor.', 'A separate-collection pilot in 3 cafés on a university campus: collection, logging and routing are tested in real café workflows.'),
  },
  {
    s: t('Taahhüt', 'Commitment'),
    k: 'done',
    t: t('Sözleşmeye giren şart', 'A contract requirement'),
    d: t('Pilot kampüsün 2027–2028 dönemi kafe ihale sözleşmelerine atık kahve posası toplama şartı eklendi.', 'Collecting waste coffee grounds has been added to the pilot campus’s 2027–2028 café tender contracts.'),
  },
  {
    s: t('Sürüyor', 'Ongoing'),
    k: 'live',
    t: t('Laboratuvar', 'Laboratory'),
    d: t('Bir üniversitenin eczacılık fakültesi laboratuvarında aroma geri kazanım deneyleri: kurutma koşulları, etanol ekstraksiyonu ve filtrasyon.', 'Aroma recovery experiments in a university pharmacy faculty laboratory: drying conditions, ethanol extraction and filtration.'),
  },
  {
    s: t('Sürüyor', 'Ongoing'),
    k: 'live',
    t: t('Parfüm tarafı', 'Perfumery side'),
    d: t('Bir kozmetik firmasıyla ekstraktın kategorik denemesi: kahve notasının hangi koku ailelerinde kullanılabileceği değerlendiriliyor.', 'A categorical trial of the extract with a cosmetics company: assessing which fragrance families the coffee note could be used in.'),
  },
  {
    s: t('9–20 Kasım 2026', '9–20 November 2026'),
    k: 'next',
    t: t('COP31 ulusal final', 'COP31 national final'),
    d: t('Kayseri birincisi olarak, Antalya’daki COP31 kapsamında yapılacak ulusal finale saha ve laboratuvar sonuçlarıyla gidiyoruz.', 'As the Kayseri winner we head to the national final held as part of COP31 in Antalya, bringing field and laboratory results.'),
  },
];
---

<SectionShell id="ilerleme" tone="light" kicker={t('Gelinen nokta', 'Where we are')} title={t('Fikirden sahaya, sahadan laboratuvara', 'From idea to field, from field to lab')}>
  <ul class="progress">
    {
      items.map((i) => (
        <li class="progress__item card" data-reveal>
          <span class={`chip chip--${i.k}`}>{i.s}</span>
          <h3>{i.t}</h3>
          <p>{i.d}</p>
        </li>
      ))
    }
  </ul>

  <p class="statement" data-reveal>
    {
      lang === 'en' ? (
        <>2027–2028 target: with a contracted collection model, <em>20 cafés</em> first, then <em>200 cafés</em> by the end of the period.</>
      ) : (
        <>2027–2028 hedefi: sözleşmeli toplama modeliyle önce <em>20 kafeye</em>, dönem sonunda <em>200 kafeye</em>.</>
      )
    }
  </p>

  <p class="source-note">{t('POSAVER proje dosyası (Ekim 2026)', 'POSAVER project file (October 2026)')}</p>
</SectionShell>

<style>
  .progress {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.9rem, 1.6vw, 1.25rem);
  }
  .progress__item {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .progress__item p {
    color: var(--muted);
    font-size: 1rem;
  }
  .chip {
    justify-self: start;
    font-size: var(--text-small);
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.06);
    color: var(--ink);
  }
  .chip--live {
    background: rgb(111 143 78 / 0.16);
    color: #3f5a27;
  }
  .chip--done {
    background: rgb(31 58 43 / 0.12);
    color: var(--forest);
  }
  .chip--next {
    background: rgb(138 90 59 / 0.14);
    color: var(--roast);
  }

  @media (max-width: 1023px) {
    .progress {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .progress {
      grid-template-columns: 1fr;
    }
  }
</style>
