---
import { url } from '../../lib/url';
import { tx, type Lang } from '../../lib/i18n';
import SectionShell from '../SectionShell.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);
---

<SectionShell id="hero" tone="dark-espresso" kicker={t('EU Climate Ideathon 2026 · Kayseri birincisi', 'EU Climate Ideathon 2026 · Kayseri winner')} title={t('Kahve biter. Koku kalır. Çöpe gitmesin.', 'Coffee ends. The scent stays. Keep it out of the bin.')} heading="h1">
  <Fragment slot="title">
    {
      lang === 'en' ? (
        <>
          <span class="hero__s">Coffee ends<span class="dot">.</span></span> <span class="hero__s">The scent stays<span class="dot">.</span></span><br />
          <span class="hero__em">Keep it out of the bin<span class="dot">.</span></span>
        </>
      ) : (
        <>
          <span class="hero__s">Kahve biter<span class="dot">.</span></span> <span class="hero__s">Koku kalır<span class="dot">.</span></span><br />
          <span class="hero__em">Çöpe gitmesin<span class="dot">.</span></span>
        </>
      )
    }
  </Fragment>
  <p class="section__lead hero__lead" data-reveal>
    {
      t(
        'Kafelerde çöpe giden kahve posasını toplayıp aromasını geri kazanıyor, parfüm ve esans üreticileri için izlenebilir bir koku girdisine dönüştürüyoruz.',
        'We collect the coffee grounds cafés throw away, recover their aroma, and turn them into a traceable fragrance ingredient for perfume and essence makers.',
      )
    }
  </p>
  <div class="hero__actions" data-reveal data-cup-avoid>
    <a class="btn btn--solid" href="#sorun">{t('Nasıl çalışıyor', 'How it works')}</a>
    <a class="link-arrow" href={url('/blog')}>{t('Blogu oku', 'Read the blog (Turkish)')}</a>
  </div>
</SectionShell>

<style is:global>
  #hero {
    justify-content: flex-start;
    align-items: center;
    gap: clamp(1rem, 2.6vh, 1.75rem);
    padding-top: clamp(5.5rem, 13vh, 8rem);
    background:
      radial-gradient(48% 42% at 50% 84%, rgb(138 90 59 / 0.42), transparent 72%),
      radial-gradient(80% 60% at 50% 100%, rgb(111 143 78 / 0.12), transparent 70%),
      var(--espresso);
  }
  #hero h1 {
    max-width: 22ch;
    font-size: clamp(2.6rem, min(5.6vw, 10.5vh), 6.25rem);
  }
  #hero .dot {
    color: var(--accent);
  }
  #hero .hero__em {
    background: linear-gradient(95deg, #f5efe6 0%, #a6cb83 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  #hero .hero__em .dot {
    color: #a6cb83;
    -webkit-text-fill-color: #a6cb83;
  }
  #hero .hero__lead {
    font-size: clamp(1.1rem, min(1.7vw, 3vh), 1.6rem);
    max-width: 40ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    width: auto;
  }

  @media (max-width: 767px) {
    #hero .hero__s {
      display: block;
    }
    #hero {
      gap: 1.1rem;
      padding-top: 6.5rem;
    }
    #hero h1 {
      font-size: clamp(2.2rem, 10vw, 3rem);
    }
  }
</style>
