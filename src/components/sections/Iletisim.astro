---
import SectionShell from '../SectionShell.astro';
import { site } from '../../data/site';
import { tx, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);

const mail = (subject: string) => `mailto:${site.contactEmail}?subject=${encodeURIComponent(subject)}`;
---

<SectionShell id="iletisim" tone="dark-espresso" kicker={t('İletişim', 'Contact')} title={t('Birlikte başlayalım', 'Let’s start together')}>
  <div class="ctas">
    <article class="cta card" data-reveal>
      <h3>{t('Pilot kafemiz ol', 'Become our pilot café')}</h3>
      <p>
        {t('Pilot bölgede ıslak kahve posanızı ayrı toplayıp parti olarak kaydetmek ister misiniz? Pilot ağımızın ve sonraki toplama rotalarımızın parçası olun.', 'Would you like to collect your wet coffee grounds separately and log them as batches in the pilot area? Be part of our pilot network and the collection routes that follow.')}
      </p>
      <a class="btn btn--solid" href={mail(t('POSAVER — Pilot kafe olmak istiyorum', 'POSAVER — I would like to be a pilot café'))} data-cup-avoid>{t('Pilot kafemiz ol', 'Become our pilot café')}</a>
    </article>
    <article class="cta card" data-reveal>
      <h3>{t('Koku ortağımız ol', 'Become our fragrance partner')}</h3>
      <p>
        {t('Parfüm, esans veya kozmetik üreticisiyseniz, izlenebilir kahve posası kökenli koku girdisinin değerlendirmesinde bizimle çalışın.', 'If you make perfume, essences or cosmetics, work with us on evaluating a traceable fragrance ingredient made from coffee grounds.')}
      </p>
      <a class="btn btn--solid" href={mail(t('POSAVER — Koku ortağı olmak istiyorum', 'POSAVER — I would like to be a fragrance partner'))} data-cup-avoid>{t('Koku ortağımız ol', 'Become our fragrance partner')}</a>
    </article>
  </div>

  <form class="form" id="contact-form" data-email={site.contactEmail} data-name-label={t('Ad soyad', 'Name')} data-email-label={t('E-posta', 'Email')} action={`mailto:${site.contactEmail}`} method="post" enctype="text/plain" data-reveal>
    <h3>{t('Bize yazın', 'Write to us')}</h3>
    <div class="form__grid">
      <label>
        <span>{t('Ad soyad', 'Full name')}</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        <span>{t('E-posta', 'Email')}</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label class="form__wide">
        <span>{t('Ben', 'I am')}</span>
        <select name="type">
          <option>{t('Kafe sahibiyim / yöneticisiyim', 'A café owner / manager')}</option>
          <option>{t('Parfüm, esans veya kozmetik üreticisiyim', 'A perfume, essence or cosmetics maker')}</option>
          <option>{t('Başka bir konuda yazıyorum', 'Writing about something else')}</option>
        </select>
      </label>
      <label class="form__wide">
        <span>{t('Mesajınız', 'Your message')}</span>
        <textarea name="message" rows="4" required></textarea>
      </label>
    </div>
    <button class="btn btn--solid" type="submit">{t('E-posta uygulamasında aç', 'Open in your email app')}</button>
  </form>
  <p class="team" data-reveal>
    <span>{t('Ekip', 'Team')}</span> Fatmanur Doğan · Batuhan Kara · Orhan Bilgin · Ali Açmak
  </p>
</SectionShell>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const subject = `POSAVER — ${d.get('type')}`;
    const body = `${form.dataset.nameLabel}: ${d.get('name')}\n${form.dataset.emailLabel}: ${d.get('email')}\n\n${d.get('message')}`;
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .team {
    color: var(--muted);
    font-size: var(--text-small);
  }
  .team span {
    color: var(--accent);
    font-weight: 600;
    margin-right: 0.75rem;
  }
  .ctas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    max-width: 62rem;
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .cta p {
    color: var(--muted);
    margin-bottom: auto;
  }

  .form {
    display: grid;
    gap: 1.5rem;
    max-width: 62rem;
  }
  .form h3 {
    font-size: 1.4rem;
  }
  .form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
  }
  .form__wide {
    grid-column: 1 / -1;
  }
  label {
    display: grid;
    gap: 0.4rem;
  }
  label span {
    font-size: var(--text-small);
    color: var(--muted);
  }
  input,
  select,
  textarea {
    font: inherit;
    color: var(--crema);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 0.6rem 0;
    border-radius: 0;
    transition: border-color 0.3s var(--ease-out);
  }
  select option {
    color: var(--espresso);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--moss);
  }
  .form .btn {
    justify-self: start;
    cursor: pointer;
  }

  @media (max-width: 719px) {
    .ctas,
    .form__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
