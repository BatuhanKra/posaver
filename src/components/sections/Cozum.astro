---
import SectionShell from '../SectionShell.astro';

const steps = [
  { t: 'Kafede ayrıştırma', d: 'Posa, genel çöpe karışmadan kaynağında ayrı toplanır.' },
  { t: 'QR ile parti ve posa kaydı', d: 'Her toplama bir parti olarak kaydedilir.' },
  { t: 'Veri destekli mikro-rota', d: 'Birikim verisine göre dinamik toplama.' },
  { t: 'Kontrollü kurutma', d: 'Stabilizasyon ile posa bozulmadan işlenir.' },
  { t: 'Aroma geri kazanımı', d: 'Etanol ekstraksiyonu ve filtrasyon.' },
  { t: 'B2B girdi', d: 'Parfüm ve esans üreticileri için koku girdisi.' },
];

const rivals = [
  { n: 'Bio-bean / Revive Eco', f: 'Enerji ve biyoyakıt odaklı değerleme' },
  { n: 'UpCircle Beauty', f: 'B2C cilt bakım ürünleri' },
  { n: 'Kaffe Bueno', f: 'Kozmetik yağları ve aktif bileşenler, ağırlıklı B2B' },
  { n: 'POSAVER', f: 'Yerel mikro-toplama + izlenebilirlik + aroma geri kazanımı, koku odaklı B2B girdi', us: true },
];
---

<SectionShell id="cozum" tone="dark-espresso" kicker="Çözüm" title="Çözümümüz ve bizi farklı kılan">
  <ol class="process">
    {
      steps.map((s, i) => (
        <li class="process__step" data-reveal>
          <span class="process__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))
    }
  </ol>

  <div class="compare" data-reveal>
    <h3 class="compare__title">Rakip karşılaştırması</h3>
    <table>
      <thead>
        <tr><th scope="col">Yaklaşım</th><th scope="col">Odak</th></tr>
      </thead>
      <tbody>
        {
          rivals.map((r) => (
            <tr class={r.us ? 'is-us' : ''}>
              <th scope="row">{r.n}</th>
              <td>{r.f}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="statement" data-reveal>
    Bizi farklı kılan; <em>posanın koku değerini kaynağında geri kazanırken</em>, birikim verisine göre dinamik rota önerileriyle yerel toplama ağını daha verimli hale getirmeyi hedeflememiz.
  </p>
</SectionShell>

<style>
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem) clamp(1.5rem, 4vw, 4rem);
  }
  .process__step {
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .process__n {
    font-size: var(--text-small);
    color: var(--accent);
    font-weight: 500;
  }
  .process__step p {
    color: var(--muted);
    max-width: 32ch;
  }

  .compare {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 62rem;
  }
  .compare__title {
    font-size: 1.25rem;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  thead th {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--muted);
  }
  tbody th {
    font-weight: 500;
    white-space: nowrap;
  }
  td {
    color: var(--muted);
  }
  .is-us th,
  .is-us td {
    color: var(--crema);
    background: rgb(111 143 78 / 0.18);
  }
  .is-us th {
    box-shadow: inset 3px 0 0 var(--moss);
  }

  @media (max-width: 1023px) {
    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .process {
      grid-template-columns: 1fr;
    }
    tbody th {
      white-space: normal;
    }
    th,
    td {
      padding: 0.75rem 0.5rem;
    }
  }
</style>
