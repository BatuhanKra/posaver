---
import { site } from '../data/site';
import { url } from '../lib/url';
---

<footer class="footer">
  <p><strong>{site.name}</strong> · {site.tagline}</p>
  <p>
    EU Climate Ideathon 2026 projesi
    <span aria-hidden="true">·</span>
    <a href={url('/yonetici/')}>Yönetici girişi</a>
  </p>
</footer>

<style>
  .footer {
    background: var(--espresso);
    color: rgb(233 220 201 / 0.66);
    padding: 2rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: var(--text-small);
    border-top: 1px solid rgb(233 220 201 / 0.14);
  }
  .footer p {
    max-width: none;
  }
  .footer strong {
    color: var(--crema);
    font-weight: 600;
  }
  .footer a {
    color: var(--crema);
    text-underline-offset: 0.25em;
  }
</style>
