---
import { site } from '../data/site';
import { url } from '../lib/url';
import { tx, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'tr' } = Astro.props;
const t = (tr: string, en: string) => tx(lang, tr, en);
---

<footer class="footer">
  <p><strong>{site.name}</strong> · {site.tagline}</p>
  <p>
    {t('EU Climate Ideathon 2026 projesi', 'An EU Climate Ideathon 2026 project')}
    <span aria-hidden="true">·</span>
    {
      lang === 'en' ? (
        <a href={url('/')} hreflang="tr" lang="tr">Türkçe</a>
      ) : (
        <a href={url('/en/')} hreflang="en" lang="en">English</a>
      )
    }
    <span aria-hidden="true">·</span>
    <a href={url('/yonetici/')}>{t('Yönetici girişi', 'Admin login')}</a>
  </p>
</footer>

<style>
  .footer {
    background: var(--espresso);
    color: rgb(233 220 201 / 0.66);
    padding: 2rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: var(--text-small);
    border-top: 1px solid rgb(233 220 201 / 0.14);
  }
  .footer p {
    max-width: none;
  }
  .footer strong {
    color: var(--crema);
    font-weight: 600;
  }
  .footer a {
    color: var(--crema);
    text-underline-offset: 0.25em;
  }
</style>
